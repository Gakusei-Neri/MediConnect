# MediConnect Plus - configuración del backend (copie a .env; `npm run seed` lo crea automáticamente)
NODE_ENV=development
PORT=3000

# RNF-01: llaves fuera del código. En producción provienen del gestor de llaves (KMS) y se rotan cada año.
JWT_SECRET=
# 32 bytes en hexadecimal (AES-256-GCM para datos clínicos e identidad en reposo)
DATA_KEY=

# RNF-01: TLS 1.3 obligatorio en producción. TLS_CA activa TLS mutuo para el Sistema de Farmacia (RES-03).
# TLS_CERT=./certs/servidor.crt
# TLS_KEY=./certs/servidor.key
# TLS_CA=./certs/ca-farmacia.crt

CORS_ORIGIN=http://localhost:4200
PORTAL_URL=http://localhost:4200

# Sistema de Farmacia (D-08: simulador local embebido en desarrollo)
FARMACIA_SIMULADA=true
FARMACIA_URL=http://localhost:4100
FARMACIA_API_KEY=farmacia-dev-key

# Planificador de tareas (D-04), en segundos
PLANIFICADOR_SEG=30
# Probabilidad 0-1 de que falle el canal principal en el simulador de notificaciones
SIM_FALLA_CANAL=0
# STUN para WebRTC (vacío = solo red local)
STUN_URLS=stun:stun.l.google.com:19302
