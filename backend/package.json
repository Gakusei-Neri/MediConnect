{
  "name": "mediconnect-backend",
  "version": "1.0.0",
  "description": "MediConnect Plus - Núcleo transaccional (API REST Node.js + Express)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/seed.js --reset",
    "totp": "node scripts/totp.js",
    "farmacia": "node src/simuladores/farmacia.js",
    "test": "node --test --test-concurrency=1 test/",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0"
  }
}
